# Copy to .env.local (gitignored). Share real values privately, never commit them.

# ── Supabase (Project Settings → API) ───────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=        # browser: realtime subscriptions only
SUPABASE_SERVICE_ROLE_KEY=            # server + seed script only, never in client code

# ── LLM: Google Gemini (OpenAI-compatible endpoint) ─────────────────
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Optional: GEMINI_MODEL=gemini-2.5-flash   GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
