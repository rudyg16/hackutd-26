# Copy to .env.local (gitignored). Share real values privately, never commit them.

# ── Supabase (Project Settings → API) ───────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=        # browser: realtime subscriptions only
SUPABASE_SERVICE_ROLE_KEY=            # server + seed script only, never in client code

# ── LLM: any OpenAI-compatible endpoint ────────────────────────────
# NVIDIA hosted (build.nvidia.com):  https://integrate.api.nvidia.com/v1
# Brev-hosted NIM / vLLM:            http://<brev-instance>:8000/v1
LLM_BASE_URL=https://integrate.api.nvidia.com/v1
LLM_API_KEY=nvapi-...
LLM_MODEL=nvidia/llama-3.3-nemotron-super-49b-v1
